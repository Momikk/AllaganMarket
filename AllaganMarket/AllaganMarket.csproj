<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.4.0.2</Version>
    <Description>追踪雇员上架物品、历史销售与市场压价情况。</Description>
    <PackageProjectUrl>https://github.com/Momikk/AllaganMarket</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AllaganLib.Data" Version="2.2.0" />
    <PackageReference Include="AllaganLib.Interface" Version="2.2.0" />
    <PackageReference Include="AllaganLib.Shared" Version="2.2.0" />
    <PackageReference Include="AllaganLib.Universalis" Version="2.2.0" />
    <PackageReference Include="DalaMock.Host" Version="6.1.6" />
    <PackageReference Include="DalaMock.Shared" Version="6.1.2" />
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ContentWithTargetPath Include="Images\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Images\logo.png</TargetPath>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="Images\logo_small.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Images\logo_small.png</TargetPath>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="Images\logo_menu.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Images\logo_menu.png</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="stylecop.json" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="CHANGELOG.md" />
  </ItemGroup>
</Project>
